# Public values only — anything EXPO_PUBLIC_* is bundled into the app and visible to users.
# Never put API secrets, payment keys or embedding keys here.

# Base URL of the API. "localhost" on a phone is the phone itself:
#   Android emulator: http://10.0.2.2:4000
#   iOS simulator:    http://localhost:4000
#   Physical device:  http://<your computer's LAN IP>:4000   (same Wi-Fi network)
# If unset in development, the app derives the host from the Expo dev server automatically.
EXPO_PUBLIC_API_URL=

# EAS project id (required for Expo push tokens in development builds / production).
EXPO_PUBLIC_EAS_PROJECT_ID=
