# =====================================================================================================
# Kantin Kwari Digital Market — API configuration
# Copy to .env (repository root) and fill in. Never commit real secrets.
# The mobile app has its own apps/mobile/.env.example (public values only).
# =====================================================================================================

NODE_ENV=development
PORT=4000
# Public base URL of this API (used for links to locally stored images and in OpenAPI docs).
API_BASE_URL=http://localhost:4000
# Informational: the URL the mobile app should use (configure it in apps/mobile/.env as EXPO_PUBLIC_API_URL).
MOBILE_API_URL=http://192.168.1.10:4000
# Behind a reverse proxy / load balancer set to the number of hops or "true" (affects rate limiting by IP).
TRUST_PROXY=loopback

# --- Database ---------------------------------------------------------------------------------------
# Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/kkdm?retryWrites=true&w=majority
# Local dev without MongoDB installed: run `npm run dev:db` and use the URI it prints.
MONGODB_URI=mongodb+srv://auwaluizziddin2212_db_user:VsZEC1bK9J9938D1@cluster0.kdivkyd.mongodb.net/
# Set false only for standalone servers without replica set (transactions unavailable).
MONGODB_TRANSACTIONS=true
# If startup fails with "querySrv EBADRESP" (your network's DNS can't resolve Atlas SRV records), set public resolvers:
MONGODB_DNS_SERVERS=

# --- Auth -------------------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- CORS (browsers only; native apps send no Origin) ---------------------------------------------------
APP_ORIGIN=
# Comma-separated. "*" is accepted in development only.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Image storage -----------------------------------------------------------------------------------
# local = files under STORAGE_LOCAL_DIR served by the API (development only); s3 = any S3-compatible store
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=
STORAGE_BUCKET=
STORAGE_REGION=
# For Cloudflare R2 / DigitalOcean Spaces / MinIO, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# --- Visual fabric search -------------------------------------------------------------------------------
# none | jina (Jina CLIP v2) | cohere (Embed v4) | local-baseline (DEVELOPMENT ONLY, not a learned model)
IMAGE_EMBEDDING_PROVIDER=none
IMAGE_EMBEDDING_API_KEY=
# Optional overrides (defaults: jina-clip-v2 / embed-v4.0, 1024 dimensions)
IMAGE_EMBEDDING_MODEL=
IMAGE_EMBEDDING_DIMENSIONS=
IMAGE_EMBEDDING_TIMEOUT_MS=20000
# atlas = MongoDB Atlas Vector Search ($vectorSearch); exhaustive = bounded cosine scan (dev / small catalogues)
VECTOR_SEARCH_PROVIDER=exhaustive
VECTOR_SEARCH_INDEX_NAME=product_image_embeddings
VECTOR_SEARCH_EXHAUSTIVE_LIMIT=20000
# Leave empty to use the provider's calibrated default.
VISUAL_SEARCH_MIN_SIMILARITY=

# --- Payments ---------------------------------------------------------------------------------------
# none | paystack | flutterwave. With "none" the app offers cash on pickup and bank transfer only.
PAYMENT_PROVIDER=none
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Flutterwave: the "secret hash" you set on the dashboard (sent as verif-hash). Paystack signs with the secret key.
PAYMENT_WEBHOOK_SECRET=
# Where the gateway redirects after payment (an app deep link or a web page), e.g. kantinkwari://payment-complete
PAYMENT_CALLBACK_URL=kantinkwari://payment-complete

# --- Verification codes ----------------------------------------------------------------------------------
# console prints codes to the server log (development only)
VERIFICATION_EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kantin Kwari Digital Market <no-reply@example.com>
VERIFICATION_SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=KantinKwari
TERMII_BASE_URL=https://api.ng.termii.com

# --- Push notifications --------------------------------------------------------------------------------
PUSH_NOTIFICATION_ENABLED=false
# Required when "Enhanced push security" is enabled for your Expo project.
EXPO_ACCESS_TOKEN=

# --- Maps (optional) ---------------------------------------------------------------------------------
MAPS_API_KEY=

# --- Operations ---------------------------------------------------------------------------------------
LOG_LEVEL=info
JOBS_ENABLED=true
SWAGGER_ENABLED=true
